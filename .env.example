# Скопируйте значения в Vercel → Project → Settings → Environment Variables.
# Ничего из этого не коммитьте в репозиторий.

# Обязательно: длинная случайная строка (≥ 32 символа) для подписи кодов и токенов доступа.
# Если её сменить, все ранее выданные коды перестанут работать.
SHOP_SECRET=

# Пароль страницы /admin.html (≥ 8 символов)
ADMIN_PASSWORD=

# Оплата картой — CloudPayments (кабинет → Сайты → Настройки). Без них вместо карты показывается WhatsApp.
CP_PUBLIC_ID=
CP_API_SECRET=
# CP_API_BASE=https://api.cloudpayments.ru

# Пробники НИШ / БИЛ / IELTS / TOEFL берутся из базы Beles (Daiyndal.kz). Те же значения, что в том проекте.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Группы bt_exams (через запятую). По умолчанию: nzm и bil-1. Продаются только экзамены с practice = true.
# STORE_NZM_GROUPS=nzm
# STORE_BIL_GROUPS=bil-1

# Карта для перевода (Kaspi), пока не подключена онлайн-оплата
# TRANSFER_CARD=4400430370817261

# Контакт для оплаты через Kaspi / WhatsApp
WHATSAPP=77773845920

# До какой даты принимать перенос старых покупок РФМШ (коды, введённые на старой версии сайта)
# MIGRATE_UNTIL=2027-06-30
